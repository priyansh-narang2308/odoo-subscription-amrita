// Brightloop Subscription Management System
// Enum-like fields are stored as strings; allowed values live in src/lib/constants.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users & access ────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("PORTAL") // ADMIN | INTERNAL | PORTAL
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer      Customer?
  resetTokens   PasswordResetToken[]
  subscriptions Subscription[]       @relation("Salesperson")
  payments      Payment[]
  activities    Activity[]

  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Customers ─────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  street    String?
  city      String?
  country   String?
  taxId     String?
  notes     String?
  userId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([name])
  @@index([email])
}

// ─── Catalog ───────────────────────────────────────────────────

model Product {
  id         String   @id @default(cuid())
  name       String
  type       String   @default("SERVICE") // SERVICE | GOODS
  salesPrice Float    @default(0)
  costPrice  Float    @default(0)
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  taxes             Tax[]
  variants          ProductVariant[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
  templateLines     QuotationTemplateLine[]
  discounts         Discount[]

  @@index([name])
}

model ProductAttribute {
  id        String           @id @default(cuid())
  name      String           @unique
  createdAt DateTime         @default(now())
  values    AttributeValue[]
}

model AttributeValue {
  id           String   @id @default(cuid())
  attributeId  String
  name         String
  defaultExtra Float    @default(0)

  attribute ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants  ProductVariant[]

  @@unique([attributeId, name])
}

model ProductVariant {
  id               String @id @default(cuid())
  productId        String
  attributeValueId String
  extraPrice       Float  @default(0)

  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue    AttributeValue          @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  subscriptionLines SubscriptionLine[]
  templateLines     QuotationTemplateLine[]

  @@unique([productId, attributeValueId])
}

model RecurringPlan {
  id              String    @id @default(cuid())
  name            String
  price           Float     @default(0)
  billingPeriod   String    @default("MONTHLY") // DAILY | WEEKLY | MONTHLY | YEARLY
  billingInterval Int       @default(1)
  minQuantity     Int       @default(1)
  startDate       DateTime?
  endDate         DateTime?
  autoClose       Boolean   @default(false)
  closable        Boolean   @default(true)
  pausable        Boolean   @default(false)
  renewable       Boolean   @default(true)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subscriptions Subscription[]
  templates     QuotationTemplate[]
}

model Tax {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("PERCENT") // PERCENT | FIXED
  amount    Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  products          Product[]
  subscriptionLines SubscriptionLine[]
  templateLines     QuotationTemplateLine[]
}

model PaymentTerm {
  id        String   @id @default(cuid())
  name      String
  dueDays   Int      @default(0)
  note      String?
  createdAt DateTime @default(now())

  subscriptions Subscription[]
  invoices      Invoice[]
}

model Discount {
  id          String    @id @default(cuid())
  name        String
  type        String    @default("PERCENT") // PERCENT | FIXED
  value       Float
  minPurchase Float     @default(0)
  minQuantity Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  usageLimit  Int?
  usedCount   Int       @default(0)
  appliesTo   String    @default("SUBSCRIPTION") // SUBSCRIPTION | PRODUCTS
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  products Product[]
  usages   DiscountUsage[]
}

model QuotationTemplate {
  id           String   @id @default(cuid())
  name         String
  validityDays Int      @default(30)
  planId       String?
  note         String?
  createdAt    DateTime @default(now())

  plan          RecurringPlan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  lines         QuotationTemplateLine[]
  subscriptions Subscription[]
}

model QuotationTemplateLine {
  id          String  @id @default(cuid())
  templateId  String
  productId   String
  variantId   String?
  description String?
  quantity    Float   @default(1)
  sequence    Int     @default(0)

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  taxes    Tax[]
}

// ─── Subscriptions ─────────────────────────────────────────────

model Subscription {
  id                 String    @id @default(cuid())
  number             String    @unique
  customerId         String
  planId             String
  templateId         String?
  paymentTermId      String?
  salespersonId      String?
  status             String    @default("DRAFT") // DRAFT | QUOTATION | CONFIRMED | ACTIVE | PAUSED | CLOSED
  startDate          DateTime
  expirationDate     DateTime?
  nextInvoiceDate    DateTime?
  quotationExpiresAt DateTime?
  notes              String?
  renewedFromId      String?   @unique
  confirmedAt        DateTime?
  closedAt           DateTime?
  closeReason        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer    Customer           @relation(fields: [customerId], references: [id])
  plan        RecurringPlan      @relation(fields: [planId], references: [id])
  template    QuotationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  paymentTerm PaymentTerm?       @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  salesperson User?              @relation("Salesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  renewedFrom Subscription?      @relation("Renewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewal     Subscription?      @relation("Renewal")
  lines       SubscriptionLine[]
  invoices    Invoice[]

  @@index([status])
  @@index([customerId])
  @@index([nextInvoiceDate])
}

model SubscriptionLine {
  id             String  @id @default(cuid())
  subscriptionId String
  productId      String?
  variantId      String?
  description    String
  quantity       Float   @default(1)
  unitPrice      Float   @default(0)
  sequence       Int     @default(0)

  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  taxes        Tax[]
}

// ─── Invoicing & payments ──────────────────────────────────────

model Invoice {
  id             String    @id @default(cuid())
  number         String    @unique
  customerId     String
  subscriptionId String?
  paymentTermId  String?
  status         String    @default("DRAFT") // DRAFT | CONFIRMED | PAID | CANCELLED
  invoiceDate    DateTime
  dueDate        DateTime
  periodStart    DateTime?
  periodEnd      DateTime?
  // Set while the invoice is live; cleared on cancel so the period can be billed again.
  // Unique per subscription => a period can never be billed twice.
  periodKey      String?
  untaxedAmount  Float     @default(0)
  discountAmount Float     @default(0)
  taxAmount      Float     @default(0)
  total          Float     @default(0)
  amountPaid     Float     @default(0)
  sentAt         DateTime?
  confirmedAt    DateTime?
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer     Customer        @relation(fields: [customerId], references: [id])
  subscription Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  paymentTerm  PaymentTerm?    @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]
  payments     Payment[]
  discounts    DiscountUsage[]

  @@unique([subscriptionId, periodKey])
  @@index([status])
  @@index([customerId])
  @@index([dueDate])
  @@index([invoiceDate])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  productId      String?
  description    String
  quantity       Float
  unitPrice      Float
  subtotal       Float
  discountAmount Float   @default(0)
  taxAmount      Float   @default(0)
  total          Float
  taxLabel       String?
  sequence       Int     @default(0)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model DiscountUsage {
  id         String   @id @default(cuid())
  discountId String
  invoiceId  String
  amount     Float
  createdAt  DateTime @default(now())

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([discountId, invoiceId])
}

model Payment {
  id          String   @id @default(cuid())
  number      String   @unique
  invoiceId   String
  method      String // BANK_TRANSFER | CARD | CASH | CHEQUE | ONLINE
  amount      Float
  date        DateTime
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([invoiceId])
}

// ─── System ────────────────────────────────────────────────────

model Sequence {
  key  String @id
  next Int    @default(1)
}

// Chatter-style audit trail shown on records
model Activity {
  id        String   @id @default(cuid())
  model     String
  recordId  String
  message   String
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([model, recordId])
}
